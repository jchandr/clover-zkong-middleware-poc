PORT=3000
ZKONG_POLL_INTERVAL_MS=60000

# Database — Postgres via docker-compose service `db`
POSTGRES_DB=clover_zkong
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Inside Docker: host is `db` (service name). From host (psql/DBeaver): host is `localhost` with exposed port 5432
DATABASE_URL=postgres://postgres:postgres@db:5432/clover_zkong
