# Clover
CLOVER_API_BASE=https://sandbox.dev.clover.com/v3/merchants
CLOVER_MERCHANT_ID=
CLOVER_CLIENT_ID=
CLOVER_CLIENT_SECRET=
# Merchant API Token (POC): sandbox.dev.clover.com → Test Merchants → <merchant> → API Token
# Used to fetch full item data after webhook (objectId → GET /items/{id})
CLOVER_API_TOKEN=

# Zkong
ZKONG_API_BASE=https://esl-eu.zkong.com
ZKONG_ACCOUNT=
ZKONG_PASSWORD=
ZKONG_MERCHANT_ID=
ZKONG_AGENCY_ID=
ZKONG_STORE_ID=

# App
PORT=3000
# The "Clover Auth Code" from Your Apps > App Settings > Webhooks in the
# Clover Developer Dashboard. Required for webhook requests to be accepted --
# see src/webhooks/handlers/clover.ts for details.
CLOVER_AUTH_CODE=

# Database — Postgres via docker-compose service `db`
POSTGRES_DB=clover_zkong
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Inside Docker: host is `db` (service name). From host (psql/DBeaver): host is `localhost` with exposed port 5432
DATABASE_URL=postgres://postgres:postgres@db:5432/clover_zkong
