{
  "name": "clover-zkong-middleware",
  "version": "0.1.0",
  "description": "Middleware syncing product catalog, price, and inventory between Clover POS and Zkong ESL Cloud",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "1.12.2",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.14.1",
    "@types/pg": "8.11.0",
    "ts-node-dev": "2.0.0",
    "typescript": "5.9.3"
  }
}
