{
  "name": "clover-zkong-middleware",
  "version": "0.1.0",
  "description": "Middleware syncing product catalog, price, and inventory between Clover POS and Zkong ESL Cloud",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build:server": "tsc -p tsconfig.json",
    "build:web": "npm run --prefix web build",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "typecheck": "tsc --noEmit && npm run --prefix web build"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "axios": "1.12.2",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "pg": "8.13.1",
    "playwright": "^1.64.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.14.1",
    "@types/pg": "8.11.0",
    "ts-node-dev": "2.0.0",
    "typescript": "5.9.3"
  }
}
